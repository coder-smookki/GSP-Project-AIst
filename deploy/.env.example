# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegra
POSTGRES_HOST=postgres
# Петлевой интерфейс: в базе пароли пользователей интерфейса и переписка.
POSTGRES_PORT_MAP=127.0.0.1:5432:5432

# Aegra (LangGraph server)
AEGRA_PORT=2026
AEGRA_HOST=0.0.0.0
PYTHONPATH=/app

# LLM (Ollama)
LLM_PROVIDER="ollama-local"
LLM_MODEL="qwen3:8b"
LLM_SUPPORT_MODEL="qwen3:8b"
# Размышления выключены намеренно: замер на qwen3:8b дал 16,3 с против
# 2,5 с при том же по существу ответе.
LLM_REASONING=0
EMBEDDING_PROVIDER="ollama-local"
# Размерность прошита в схему коллекции Qdrant и не меняется на лету:
# индекс собран на bge-m3 (1024). Смена модели требует нового поколения
# коллекции и переиндексации, иначе поиск падает с «expected dim: 1024».
EMBEDDING_MODEL="bge-m3"
LLM_NUM_CTX=32768
LLM_REPEAT_PENALTY=1.1
OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434

# GUI
GUI_PORT=8000
AEGRA_URL=http://aegra:2026
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAINLIT_AUTH_SECRET=change-me-to-a-random-secret
# PostgreSQL connection for user registration storage
GUI_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chainlit
# Admin bypass credentials — always works, for testing the GUI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Observability (OpenLIT, optional)
# Activate with: docker compose -f docker-compose.yml -f docker-compose.observability.yml --profile obs up -d
# Empty = tracing disabled. Set the endpoint only when running the obs profile.
OTLP_ENDPOINT=
OPENLIT_UI_PORT=3000
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=OPENLIT
OPENLIT_DB_NAME=openlit

# Поиск: qdrant в бою, mock — синтетическая заглушка на 4 чанка
RETRIEVAL_PROVIDER="qdrant"
QDRANT_URL="http://qdrant:6333"
QDRANT_COLLECTION="aist_chunks"   # это алиас; поколения переключаются атомарно
QDRANT_TIMEOUT=10.0

# Сколько фрагментов уходит в контекст модели.
# НИЖЕ ПЯТИ БЕЗ ПЕРЕОЦЕНКИ НЕ ОПУСКАТЬ: при двух-трёх фрагментах замер дал
# уверенную выдумку вместо верного ответа (подробности в README).
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH=30             # кандидатов на канал гибрида до слияния
RETRIEVAL_RRF_K=60

# Порог косинуса, ниже которого выдача считается пустой и ассистент честно
# отвечает «В базе знаний информации нет». Перепроверять при смене эмбеддера.
RETRIEVAL_MIN_RELEVANCE=0.55

# Переоценка кросс-энкодером. Выключена: тянет sentence-transformers с torch
# и стоит ~4,5 с на текущем железе. Включение: uv sync --extra rerank
RERANK_ENABLED=0
RERANK_MODEL="BAAI/bge-reranker-v2-m3"
RERANK_DEVICE=                    # mps | cuda | cpu; пусто — выбор библиотекой
RERANK_HALF_PRECISION=1
RERANK_CANDIDATES=10

# Отсев фрагментов моделью. Выключен по результату замера: внедоменные
# вопросы отсекает порог выше, а на доменных грейдер терял ответ.
GRADING_ENABLED=0
GRADING_KEEP_PARTIAL=1            # при включении не резать «частично относящиеся»

# Помечать в ответе числа, которых нет в найденных выдержках. Защита от
# выдуманного срока со ссылкой на источник — самой опасной из ошибок.
VERIFY_NUMBERS=1

# База знаний организаторов (индексация через API).
# Учётные данные хранятся только здесь и в логи не попадают.
KB_BASE_URL="https://hihub.ru/"
KB_EMAIL=
KB_PASSWORD=
KB_SECTION_ID=44030
KB_PER_PAGE=100
KB_MAX_RETRIES=3

# Папка с выгруженным корпусом для индексации из файлов (--source files).
CORPUS_DIR="tests/fixtures/corpus"

# Запрет обращений наружу. При AIST_OFFLINE=1 источник, ходящий в API, не
# стартует, а падает с внятной ошибкой — страховка от случайного выхода в
# сеть на демонстрации.
AIST_OFFLINE=0

# Оркестрация через Prefect (профиль orc, см. docker-compose.orchestration.yml)
# Activate with: docker compose -f docker-compose.yml -f docker-compose.orchestration.yml --profile orc up -d
PREFECT_UI_PORT=4200
# Расписание прогона на cron (например "0 2 * * *"); пусто = по кнопке.
AIST_CRON=
AIST_SOURCE_KIND="files"          # files | api
AIST_CORPUS_DIR="/corpus"         # путь внутри контейнера раннера
AIST_CORPUS_MOUNT="../corpus"     # путь корпуса на хосте (bind-mount)
AIST_DRY_RUN=0
AIST_FULL=0
AIST_SWITCH_ALIAS=1
AIST_DEPLOYMENT_NAME="aist-ingest"
# Учётные данные для --source api, если AIST_SOURCE_KIND=api.
# AIST_SECTION_ID=
# AIST_LIMIT=
