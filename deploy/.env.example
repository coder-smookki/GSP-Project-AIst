# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegra
# Адреса внутри docker-стека подставляет сам compose
# (${ПЕРЕМЕННАЯ:-значение}), а на хосте верны умолчания из settings.py.
# Держать их здесь нельзя: файл читается и с хоста, и тогда попытка
# сходить на qdrant:6333 или postgres:5432 с хоста не разрешится.
#POSTGRES_HOST=postgres
# Петлевой интерфейс: в базе пароли пользователей интерфейса и переписка.
POSTGRES_PORT_MAP=127.0.0.1:5432:5432

# Aegra (LangGraph server)
AEGRA_PORT=2026
AEGRA_HOST=0.0.0.0
PYTHONPATH=/app

# LLM (Ollama)
LLM_PROVIDER="ollama-local"
# Модель демо-машины (M5 Pro, 48 ГБ). На ней перезамер дал 10/10 честных
# отказов против 6/10 у qwen3:8b — вопрос выдумки закрыт моделью.
LLM_MODEL="gpt-oss:20b"
LLM_SUPPORT_MODEL="gpt-oss:20b"
# Размышления выключены намеренно: замер на qwen3:8b дал 16,3 с против
# 2,5 с при том же по существу ответе.
LLM_REASONING=0
EMBEDDING_PROVIDER="ollama-local"
# Лучший кандидат по бенчмарку: qwen3-embedding:4b (2560 измерений,
# коллекция aist_chunks_v2) — hit@1 0.829 против 0.805 у bge-m3 при тех же
# hit@3/5, честности и латенси. Размерность прошита в схему коллекции Qdrant
# и не меняется на лету: смена модели требует нового поколения коллекции и
# переиндексации, иначе поиск падает с «expected dim: …».
#
# Лучшие параметры для bge-m3 (коллекция aist_chunks, 1024): top_k=3,
# prefetch=10, rrf_k=40, min_rel=0.45 → hit@1 0.805 / MRR 0.858.
EMBEDDING_MODEL="qwen3-embedding:4b"
# Инструкция на стороне запроса для qwen3-embedding (карточка модели её
# рекомендует); bge-m3 не нужна (пусто). Замер сделан с пустой для честного
# сравнения — если поставить инструкцию, метрики могут ещё подрасти.
EMBEDDING_QUERY_INSTRUCTION=""
LLM_NUM_CTX=32768
LLM_REPEAT_PENALTY=1.1
#OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434

# Облачный vLLM (VPS организаторов). Включается сменой провайдеров:
# LLM_PROVIDER=vllm, EMBEDDING_PROVIDER=vllm, RERANK_PROVIDER=vllm.
# Имена моделей тогда задаются иначе: у vLLM это идентификатор Hugging Face
# (например Qwen/Qwen3-8B), а не тег Ollama.
# Один процесс vLLM обслуживает ровно одну модель, поэтому генерация,
# эмбеддинги и переоценка живут на разных портах; пустые адреса эмбеддера и
# реранкера означают «тот же, что VLLM_BASE_URL».
# VLLM_BASE_URL="http://vllm-host:8000"
# VLLM_EMBEDDING_BASE_URL="http://vllm-host:8001"
# VLLM_RERANK_BASE_URL="http://vllm-host:8002"
# Ключ сервера, запущенного с --api-key; уходит как Authorization: Bearer.
# VLLM_API_KEY=
# VLLM_TIMEOUT=300.0

# GUI
GUI_PORT=8000
#AEGRA_URL=http://aegra:2026
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAINLIT_AUTH_SECRET=change-me-to-a-random-secret
# PostgreSQL connection for user registration storage
#GUI_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chainlit
# Admin bypass credentials — always works, for testing the GUI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Observability (OpenLIT, optional)
# Activate with: docker compose -f docker-compose.yml -f docker-compose.observability.yml --profile obs up -d
# Empty = tracing disabled. Set the endpoint only when running the obs profile.
OTLP_ENDPOINT=
OPENLIT_UI_PORT=3000
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=OPENLIT
OPENLIT_DB_NAME=openlit

# Поиск: qdrant в бою, mock — синтетическая заглушка на 4 чанка
RETRIEVAL_PROVIDER="qdrant"
#QDRANT_URL="http://qdrant:6333"
# Поколение под qwen3-embedding (2560 dim). Для bge-m3 — «aist_chunks» (1024).
QDRANT_COLLECTION="aist_chunks_v2"
QDRANT_TIMEOUT=10.0

# Сколько фрагментов уходит в контекст модели.
# НИЖЕ ПЯТИ БЕЗ ПЕРЕОЦЕНКИ НЕ ОПУСКАТЬ: при двух-трёх фрагментах замер дал
# уверенную выдумку вместо верного ответа (подробности в README).
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH=10             # кандидатов на канал гибрида до слияния
RETRIEVAL_RRF_K=40

# Порог косинуса, ниже которого выдача считается пустой и ассистент честно
# отвечает «В базе знаний информации нет». Для обоих эмбеддеров — плато
# 0.1–0.5, метрики не меняются; 0.55+ заметно режет выдачу (у qwen3 сильнее:
# 0.55 даёт 0.762 против 0.829). 0.45 — выбор с запасом.
RETRIEVAL_MIN_RELEVANCE=0.45

# Переоценка кросс-энкодером. На демо-машине окупается: поиск 302 мс против
# 127 мс, hit@1 0,732 против 0,561. Веса запечены в образ при сборке
# (Dockerfile, HF_HOME=/opt/rerank-cache), HF_HUB_OFFLINE=1 — включение не
# обращается наружу. Если меняете RERANK_MODEL — пересоберите образ: при
# офлайне незапечённая модель не загрузится, а переоценка бесшумно
# отключится до перезапуска.
RERANK_ENABLED=1
# Кто считает переоценку: auto | local | http | vllm. auto - хост-сервис,
# если задан RERANK_ENDPOINT, иначе локальный расчёт.
RERANK_PROVIDER="auto"
RERANK_MODEL="BAAI/bge-reranker-v2-m3"
# mps | cuda | cpu — пустой выбор библиотекой (в образе: CPU)
RERANK_DEVICE=
RERANK_HALF_PRECISION=1
# Хост-сервис переоценки (deploy/rerank_server.py, MPS на macOS). Colima не
# пробрасывает GPU: инференс в контейнере ~16x медленнее нативного торча.
# Запускается на хосте: `.venv/bin/python deploy/rerank_server.py`. Пустое
# значение = считать локально в контейнере (медленно, но работает офлайн).
#RERANK_ENDPOINT="http://host.docker.internal:8899"
# Окно переоценки: 10 — оптимум (3/5 теряют hit@1: 0.73/0.81 против 0.83;
# 15 даёт только чуть лучший хвост при +75 мс — не взяли). Для bge-m3 тоже 10.
RERANK_CANDIDATES=10

# Отсев фрагментов моделью. Выключен по результату замера: внедоменные
# вопросы отсекает порог выше, а на доменных грейдер терял ответ.
GRADING_ENABLED=0
GRADING_KEEP_PARTIAL=1            # при включении не резать «частично относящиеся»

# Помечать в ответе числа, которых нет в найденных выдержках. Защита от
# выдуманного срока со ссылкой на источник — самой опасной из ошибок.
VERIFY_NUMBERS=1

# База знаний организаторов (индексация через API).
# Учётные данные хранятся только здесь и в логи не попадают.
KB_BASE_URL="https://hihub.ru/"
KB_EMAIL=
KB_PASSWORD=
KB_SECTION_ID=44030
KB_PER_PAGE=100
KB_MAX_RETRIES=3

# Папка с выгруженным корпусом для индексации из файлов (--source files).
CORPUS_DIR="tests/fixtures/corpus"

# Запрет обращений наружу. При AIST_OFFLINE=1 источник, ходящий в API, не
# стартует, а падает с внятной ошибкой — страховка от случайного выхода в
# сеть на демонстрации.
AIST_OFFLINE=0

# Оркестрация через Prefect (слой orc, см. docker-compose.orchestration.yml).
# Слой подключается к основному стеку через include и поднимается вместе с
# docker compose up -d; отдельно: docker compose -f docker-compose.orchestration.yml up -d
PREFECT_UI_PORT=4200
# Расписание прогона на cron (например "0 2 * * *"); пусто = по кнопке.
AIST_CRON=
AIST_SOURCE_KIND="files"          # files | api
AIST_CORPUS_DIR="/corpus"         # путь внутри контейнера раннера
AIST_CORPUS_MOUNT="../corpus"     # путь корпуса на хосте (bind-mount)
AIST_DRY_RUN=0
AIST_FULL=0
AIST_SWITCH_ALIAS=1
AIST_DEPLOYMENT_NAME="aist-ingest"
# Учётные данные для --source api, если AIST_SOURCE_KIND=api.
# AIST_SECTION_ID=
# AIST_LIMIT=
