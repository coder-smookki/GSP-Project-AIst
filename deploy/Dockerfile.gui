FROM python:3.12-slim-bookworm

WORKDIR /app

# sqlalchemy, greenlet и aiofiles нужны слою данных Chainlit
# (`chainlit.data.sql_alchemy`), на котором держится сохранение диалогов
# между перезагрузками. В зависимости самого chainlit они не входят — это
# необязательная часть, — поэтому без них образ собирался, но контейнер
# падал на импорте с `ModuleNotFoundError: No module named 'sqlalchemy'`
# и уходил в бесконечный перезапуск.
RUN pip install --no-cache-dir \
    chainlit>=2.11.0 \
    langgraph-sdk>=0.3.0 \
    asyncpg>=0.30.0 \
    bcrypt>=4.2.0 \
    "sqlalchemy[asyncio]>=2.0.0" \
    greenlet>=3.0.0 \
    aiofiles>=24.1.0 \
    rich

COPY gui/ ./gui/
COPY chainlit.toml ./
# Фирменный стиль: палитра, таблица стилей, логотипы и значок.
# Chainlit ищет их в каталоге public рядом с приложением, а настройки
# темы - в .chainlit/config.toml.
COPY public/ ./public/
COPY .chainlit/ ./.chainlit/

# Без этого пакет gui не импортируется: chainlit кладёт в sys.path каталог
# самого скрипта (/app/gui), а не корень приложения, и запуск падает на
# `No module named 'gui'`. У сервиса агента переменная задана в compose,
# у интерфейса её не было - контейнер уходил в цикл перезапуска.
ENV PYTHONPATH=/app

EXPOSE 8000

ENV AEGRA_URL=http://aegra:2026

CMD ["chainlit", "run", "gui/chainlit_app.py", "--host", "0.0.0.0", "--port", "8000"]
