FROM python:3.12-slim-bookworm

WORKDIR /app

RUN pip install --no-cache-dir \
    chainlit>=2.11.0 \
    langgraph-sdk>=0.3.0 \
    asyncpg>=0.30.0 \
    bcrypt>=4.2.0 \
    rich

COPY gui/ ./gui/
COPY chainlit.toml ./

EXPOSE 8000

ENV AEGRA_URL=http://aegra:2026

CMD ["chainlit", "run", "gui/chainlit_app.py", "--host", "0.0.0.0", "--port", "8000"]
