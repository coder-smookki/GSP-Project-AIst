# Шаблон окружения. Скопируйте в .env и заполните.
# Файл .env в репозиторий не попадает (см. .gitignore): в нём учётные данные.
#
#   cp .env.template .env

# ------------------------------------------------------------------ модели
# Всё локально: внешних API в решении нет, и это блокирующее требование
# кейса. Проверяется запуском образа без сети (docker run --network none).
LLM_PROVIDER="ollama-local"          # ollama-local | llamacpp | vllm
LLM_MODEL="qwen3:8b"                 # модель, пишущая ответ
LLM_SUPPORT_MODEL="qwen3:8b"         # служебная: сжатие истории, память, коррекция запроса
LLM_NUM_CTX=16384

# Размышления модели выключены намеренно: замер на qwen3:8b дал 16,3 с
# против 2,5 с при том же по существу ответе.
LLM_REASONING=0

OLLAMA_LOCAL_BASE_URL="http://localhost:11434"

EMBEDDING_PROVIDER="ollama-local"
EMBEDDING_MODEL="bge-m3"             # 1024 измерения, MIT, префиксы не нужны

# ------------------------------------------------------------------ поиск
# mock — синтетическая заглушка на 4 фрагмента, годится только для тестов
# интерфейса. Для боевого режима нужен qdrant.
RETRIEVAL_PROVIDER="qdrant"          # mock | qdrant

QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="aist_chunks"      # это алиас; поколения переключаются атомарно
QDRANT_TIMEOUT=10.0

# Сколько фрагментов уходит в контекст модели.
# НИЖЕ ПЯТИ БЕЗ ПЕРЕОЦЕНКИ НЕ ОПУСКАТЬ: при двух-трёх фрагментах замер дал
# уверенную выдумку вместо верного ответа (подробности в README).
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH=30                # кандидатов на канал гибрида до слияния
RETRIEVAL_RRF_K=60

# Порог косинуса, ниже которого выдача считается пустой и ассистент честно
# отвечает «В базе знаний информации нет». Перепроверять при смене эмбеддера.
RETRIEVAL_MIN_RELEVANCE=0.55

# ------------------------------------------------------------- переоценка
# Выключена: тянет sentence-transformers с torch и стоит ~4,5 с на текущем
# железе. Включение: uv sync --extra rerank
RERANK_ENABLED=0
RERANK_MODEL="BAAI/bge-reranker-v2-m3"
RERANK_DEVICE=""                     # mps | cuda | cpu; пусто — выбор библиотекой
RERANK_HALF_PRECISION=1
RERANK_CANDIDATES=10

# --------------------------------------------------------------- грейдинг
# Отсев фрагментов моделью. Выключен по результату замера: внедоменные
# вопросы отсекает порог выше, а на доменных грейдер терял ответ.
GRADING_ENABLED=0
GRADING_KEEP_PARTIAL=1               # при включении не резать «частично относящиеся»

# ------------------------------------------------------- база знаний (API)
# Учётные данные организаторов. Хранятся только здесь, в логи не попадают.
KB_BASE_URL="https://hihub.ru/"
KB_EMAIL=""
KB_PASSWORD=""
KB_SECTION_ID=44030
KB_PER_PAGE=100
KB_MAX_RETRIES=3

# Папка с выгруженным корпусом для индексации из файлов (--source files).
CORPUS_DIR="tests/fixtures/corpus"

# Запрет любых сетевых обращений наружу. При AIST_OFFLINE=1 источник,
# ходящий в API, не стартует, а падает с внятной ошибкой — это страховка
# от случайного выхода в сеть на демонстрации.
AIST_OFFLINE=0

# --------------------------------------------------------- наблюдаемость
# Пусто = телеметрия выключена. Стек наблюдаемости вынесен в отдельный
# overlay (deploy/docker-compose.observability.yml) и в передаваемый образ
# не входит: там лицензии, несовместимые с условиями кейса.
OTLP_ENDPOINT=""
